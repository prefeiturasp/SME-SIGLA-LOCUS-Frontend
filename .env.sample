# URL base da API do LOCUS (microsservico de unidades educacionais)
VITE_LOCUS_API_URL=url-da-api-do-locus

# Path publico da app no browser (build-time). Em QA use /locus/
# VITE_BASE_PATH=/locus/
VITE_BASE_PATH=/locus/

# Somente local: quando "local", aceita TOKEN/USUARIO/NOME_USUARIO na query.
# Em QA/prod deixe vazio ou outro valor.
ENVIRONMENT=local
